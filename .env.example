# Copy to .env (never commit real keys)
# Qloo hackathon API key — request via the Google Form in the Qloo developer guide.
# Valid ONLY against https://hackathon.api.qloo.com (X-Api-Key header).
QLOO_API_KEY=

# Google AI Studio (Gemini) free-tier key — optional; used for narration only.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
